#!/bin/sh
# Block a commit that introduces real AWS/environment identifiers.
# Delegates to the single scanner: a generic account-ID-in-ARN heuristic plus
# the local, git-ignored .githooks/sensitive_patterns.txt term list (never
# committed). Enable with: make install-hooks.
# Bypassing this hook with --no-verify is FORBIDDEN.
exec "$(git rev-parse --show-toplevel)/scripts/check-no-real-data.sh" --staged
