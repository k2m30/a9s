{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "65",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(ls *)",
      "Bash(rg *)",
      "Bash(stat *)",
      "Bash(tail *)",
      "Bash(tree *)",
      "Bash(wc *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(go *)",
      "Bash(golangci-lint *)",
      "Bash(govulncheck *)",
      "Bash(docker *)",
      "Bash(aws *)",
      "Bash(curl *)",
      "Bash(rtk*)",
      "Bash(cd*)",
      "Bash(echo *)",
      "Bash(env)",
      "Bash(file *)",
      "Bash(jq *)",
      "Bash(md5*)",
      "Bash(pwd)",
      "Bash(sort*)",
      "Bash(tee*)",
      "Bash(which *)",
      "Bash(xattr*)",
      "Bash(xxd*)",
      "Bash(yq *)",
      "Bash(./a9s*)",
      "Bash(make*)",
      "Bash(bash .claude/scripts/*)",
      "Bash(bash .specify/scripts/*)",
      "Bash(brew *)",
      "Bash(dig *)",
      "Bash(nc *)",
      "Bash(nslookup *)",
      "Bash(openssl *)",
      "Bash(ping *)",
      "Bash(ssh *)",
      "Bash(chmod*)",
      "Bash(cp *)",
      "Bash(do *)",
      "Bash(done)",
      "Bash(for *)",
      "Bash(ffmpeg*)",
      "Bash(hugo*)",
      "Bash(nm *)",
      "Bash(python3*)",
      "Bash(rm *)",
      "Bash(vhs*)",
      "Bash(/tmp/*)",
      "Edit(/tmp/**)",
      "Read(/tmp/**)",
      "Write(/tmp/**)",
      "Read(~/go/pkg/**)",
      "Read(*/projects/**)",
      "Read(~/.claude/**)",
      "Edit(~/.claude/**)",
      "Write(~/.claude/**)",
      "Read(~/.a9s/**)",
      "Write(~/.a9s/**)",
      "Grep(~/.a9s/**)",
      "Glob(~/.a9s/**)",
      "Read(.claude/**)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "mcp__aws-api__call_aws",
      "mcp__ide__getDiagnostics",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_github_github__add_issue_comment",
      "mcp__plugin_github_github__create_repository",
      "mcp__plugin_github_github__get_commit",
      "mcp__plugin_github_github__get_file_contents",
      "mcp__plugin_github_github__get_latest_release",
      "mcp__plugin_github_github__issue_read",
      "mcp__plugin_github_github__issue_write",
      "mcp__plugin_github_github__list_commits",
      "mcp__plugin_github_github__list_issues",
      "mcp__plugin_github_github__list_pull_requests",
      "mcp__plugin_github_github__list_releases",
      "mcp__plugin_github_github__merge_pull_request",
      "mcp__plugin_github_github__pull_request_read",
      "mcp__plugin_github_github__pull_request_review_write",
      "mcp__plugin_github_github__search_issues",
      "mcp__plugin_github_github__search_pull_requests",
      "mcp__plugin_github_github__update_pull_request_branch",
      "mcp__plugin_playwright_playwright__browser_evaluate",
      "mcp__plugin_playwright_playwright__browser_navigate",
      "mcp__plugin_playwright_playwright__browser_resize",
      "mcp__plugin_playwright_playwright__browser_take_screenshot",
      "Skill(code-review:code-review)",
      "Skill(commit-commands:commit)",
      "Skill(commit-commands:commit-push-pr)",
      "Skill(update-config)",
      "Agent",
      "SendMessage",
      "WebFetch",
      "WebSearch",
      "Glob",
      "Grep",
      "KillShell",
      "LSP",
      "NotebookEdit",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "TaskUpdate",
      "ToolSearch"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=$(python3 -c \"import json,sys; d=json.load(sys.stdin); print(d.get('tool_input',d).get('command',''))\" 2>/dev/null || true); case \"$CMD\" in *grep*|*rg\\ *|*find\\ *|*fd\\ *|*ack\\ *|*ag\\ *) case \"$CMD\" in *core/*|*internal/*|*cmd/*|*tests/*) [ -f graphify-out/graph.json ] && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"graphify-out/graph.json is present: `graphify query \\\"<question>\\\"` returns a scoped subgraph of the repo source, usually smaller than the grep output. Grep raw files once it has oriented you, or to modify specific lines.\\\"}}' || true ;; esac ;; esac"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/require-arch-verdict.py"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "HIT=$(python3 -c \"import json,sys;d=json.load(sys.stdin);t=d.get('tool_input',d);j=' '.join(str(t.get(k) or '') for k in ('file_path','pattern','path')).replace(chr(92),'/');sys.stdout.write('1' if any(s in j for s in ('core/','internal/','cmd/','tests/')) else '')\" 2>/dev/null || true); if [ \"$HIT\" = 1 ] && [ -f graphify-out/graph.json ]; then echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"graphify-out/graph.json is present: `graphify query \\\"<question>\\\"`, `graphify explain \\\"<concept>\\\"` or `graphify path \\\"<A>\\\" \\\"<B>\\\"` returns a scoped subgraph of the repo source. Read raw files once it has oriented you, or to modify specific lines.\\\"}}'; fi || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "F=$(python3 -c \"import json,sys;d=json.load(sys.stdin);print(d.get('tool_input',{}).get('file_path',''))\" 2>/dev/null || true); case \"$F\" in *.go) gofmt -l \"$F\" 2>/dev/null | grep -q . && printf '{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"additionalContext\":\"gofmt reports %s as unformatted. Run gofmt -w on it before the gate.\"}}' \"$F\" ;; esac; exit 0"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f ./.claude/task-context.md ] && cat ./.claude/task-context.md; exit 0"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "a9s-dev",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f .claude/hooks/require-green-gate.py ] || exit 0; python3 .claude/hooks/require-green-gate.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  }
}
